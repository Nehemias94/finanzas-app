# Variable con la dirección base de la API, para no repetirla
@baseUrl = http://localhost:8000/api

### 1. REGISTRO
# "Accept: application/json" le dice a Laravel que queremos respuestas en JSON
# "Content-Type: application/json" le dice que lo que enviamos también es JSON
POST {{baseUrl}}/register
Accept: application/json
Content-Type: application/json

{
  "name": "Nehemias",
  "email": "nehemias@ejemplo.com",
  "password": "password123",
  "password_confirmation": "password123"
}

### 2. LOGIN
# "@name login" guarda la respuesta con el nombre "login"
# para poder usar su token en las siguientes peticiones
# @name login
POST {{baseUrl}}/login
Accept: application/json
Content-Type: application/json

{
  "email": "{{$dotenv API_TEST_EMAIL}}",
  "password": "{{$dotenv API_TEST_PASSWORD}}"
}

### 3. QUIÉN SOY (requiere token)
# {{login.response.body.token}} toma el token de la respuesta del login automáticamente
GET {{baseUrl}}/me
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 4. LOGOUT (requiere token)
POST {{baseUrl}}/logout
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### ========== CATEGORÍAS ==========
# IMPORTANTE: antes de probar, ejecuta el LOGIN (petición 2) para tener un token válido
# (si hiciste logout en el paso anterior, ese token ya no sirve)

### 5. CREAR categoría de egreso
# @name crearRopa
POST {{baseUrl}}/categories
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Ropa",
  "type": "expense",
  "color": "#E74C3C"
}

### 6. CREAR categoría de ingreso
POST {{baseUrl}}/categories
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Salario",
  "type": "income",
  "color": "#2ECC71"
}

### 7. LISTAR todas mis categorías
GET {{baseUrl}}/categories
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 8. LISTAR solo egresos
GET {{baseUrl}}/categories?type=expense
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 9. BUSCAR por nombre (como el autocompletado del frontend)
GET {{baseUrl}}/categories?search=rop
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 10. VER una categoría (usa el id de la que se creó en la petición 5)
GET {{baseUrl}}/categories/{{crearRopa.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 11. EDITAR solo el color
PATCH {{baseUrl}}/categories/{{crearRopa.response.body.data.id}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "color": "#9B59B6"
}

### 12. BORRAR la categoría
DELETE {{baseUrl}}/categories/{{crearRopa.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.token}}


### ========== PRUEBA DE SEGURIDAD ==========
# Creamos un SEGUNDO usuario e intentamos ver una categoría del primero

### 13. Registrar un segundo usuario
# @name intruso
POST {{baseUrl}}/register
Accept: application/json
Content-Type: application/json

{
  "name": "Intruso",
  "email": "intruso@ejemplo.com",
  "password": "password123",
  "password_confirmation": "password123"
}

### 14. El intruso intenta ver una categoría ajena (debe dar 403)
GET {{baseUrl}}/categories/{{crearRopa.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{intruso.response.body.token}}

### 15. El intruso lista categorías (debe salir vacío, no las tuyas)
GET {{baseUrl}}/categories
Accept: application/json
Authorization: Bearer {{intruso.response.body.token}}

### ========== MOVIMIENTOS ==========
# Antes de empezar, ejecuta el LOGIN (petición 2) para tener un token fresco

### 16. Crear una categoría de egreso para las pruebas
# @name catGasto
POST {{baseUrl}}/categories
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Comida",
  "type": "expense",
  "color": "#F39C12"
}

### 17. Crear una categoría de ingreso para las pruebas
# @name catIngreso
POST {{baseUrl}}/categories
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Trabajos extra",
  "type": "income",
  "color": "#1ABC9C"
}

### 18. Registrar un GASTO
# @name gasto
POST {{baseUrl}}/transactions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "category_id": {{catGasto.response.body.data.id}},
  "amount": 25.50,
  "date": "2026-09-20",
  "description": "Almuerzo con amigos"
}

### 19. Registrar un INGRESO
POST {{baseUrl}}/transactions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "category_id": {{catIngreso.response.body.data.id}},
  "amount": 150,
  "date": "2026-09-18",
  "description": "Diseño de un logo"
}

### 20. Registrar un gasto de AGOSTO (para probar el filtro por mes)
POST {{baseUrl}}/transactions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "category_id": {{catGasto.response.body.data.id}},
  "amount": 12,
  "date": "2026-08-05"
}

### 21. LISTAR movimientos del mes actual (septiembre)
GET {{baseUrl}}/transactions
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 22. LISTAR movimientos de agosto
GET {{baseUrl}}/transactions?month=2026-08
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 23. LISTAR solo gastos de septiembre
GET {{baseUrl}}/transactions?month=2026-09&type=expense
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 24. EDITAR el monto del gasto
PATCH {{baseUrl}}/transactions/{{gasto.response.body.data.id}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "amount": 30
}

### 25. Intentar BORRAR una categoría que tiene movimientos (debe dar 409)
DELETE {{baseUrl}}/categories/{{catGasto.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 26. Intentar un monto negativo (debe dar 422)
POST {{baseUrl}}/transactions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "category_id": {{catGasto.response.body.data.id}},
  "amount": -10,
  "date": "2026-09-20"
}


### ========== SEGURIDAD DE MOVIMIENTOS ==========
# Ejecuta antes el registro del intruso (13). Si ya existe, dará 422;
# en ese caso agrega "# @name intruso" encima de un login con su correo

### 27. El intruso intenta VER tu gasto (debe dar 403)
GET {{baseUrl}}/transactions/{{gasto.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{intruso.response.body.token}}

### 28. El intruso intenta registrar un gasto en TU categoría (debe dar 422)
POST {{baseUrl}}/transactions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{intruso.response.body.token}}

{
  "category_id": {{catGasto.response.body.data.id}},
  "amount": 100,
  "date": "2026-09-20"
}

### 29. BORRAR el gasto (debe dar 204)
DELETE {{baseUrl}}/transactions/{{gasto.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.token}}


### ========== RESUMEN MENSUAL ==========

### 30. Configurar el saldo inicial en $300
PATCH {{baseUrl}}/me
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "initial_balance": 300
}

### 31. Resumen de AGOSTO
GET {{baseUrl}}/summary?month=2026-08
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 32. Resumen de SEPTIEMBRE
GET {{baseUrl}}/summary?month=2026-09
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 33. Resumen de OCTUBRE (sin movimientos todavía)
GET {{baseUrl}}/summary?month=2026-10
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### 34. Intentar un saldo inicial negativo (debe dar 422)
PATCH {{baseUrl}}/me
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "initial_balance": -50
}

### Intentar convertir un gasto en ingreso cambiando la categoría (debe dar 422)
PATCH {{baseUrl}}/transactions/ID_DE_UN_GASTO
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "category_id": ID_DE_UNA_CATEGORIA_DE_INGRESO
}

### Historial de los últimos 6 meses
GET {{baseUrl}}/summary/history?month=2026-09&months=6
Accept: application/json
Authorization: Bearer {{login.response.body.token}}

### Salud del servidor (no necesita token)
GET {{baseUrl}}/health
Accept: application/json