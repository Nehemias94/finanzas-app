# Las contraseñas NUNCA van dentro de la imagen: en Render se configuran aparte
.env
.env.*
!.env.example

# Dependencias: se instalan dentro del contenedor con composer install
vendor

# Archivos de Git y de desarrollo que no se necesitan en producción
.git
node_modules
tests
api.http

# Archivos temporales generados en tu computadora
# (en especial bootstrap/cache, que guarda la lista de paquetes de desarrollo)
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php